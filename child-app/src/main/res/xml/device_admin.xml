<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal device-admin policy: enough to enforce screen-time limits the parent
  set (lock the screen), nothing that hides the app or prevents uninstall.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
