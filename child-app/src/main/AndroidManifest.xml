<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      All permissions are requested openly, each with an in-app explanation.
      The Child app is always visible (launcher icon below) — no stealth mode.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- One-shot, visible screen capture via MediaProjection (system consent + recording indicator). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Special access (granted via visible system screens), for screen-time enforcement. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".ChildApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/ic_shield"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Always visible: a real launcher entry the child can see and open. -->
        <activity
            android:name=".disclosure.DisclosureActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shown at setup, before pairing completes. Not a launcher entry. -->
        <activity
            android:name=".pairing.PairingActivity"
            android:exported="false" />

        <!-- Primary capture feed: system-wide notification text. -->
        <service
            android:name=".capture.NotificationCaptureService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Gap-filler feed: on-screen text (per-app parsers). -->
        <service
            android:name=".capture.ScreenTextAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Keeps capture alive, with a persistent notification that doubles as disclosure. -->
        <service
            android:name=".capture.CaptureForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Visible device-admin for screen-time enforcement (force-lock only; never hides app). -->
        <receiver
            android:name=".enforce.ChildDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
          One-shot screen capture. foregroundServiceType="mediaProjection" means
          the OS shows its recording indicator while the projection is held; this
          service never suppresses it and takes a single frame per request. The
          capability itself is build-gated (BuildConfig.ALLOW_SCREEN_CAPTURE).
        -->
        <service
            android:name=".media.MediaProjectionCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>
</manifest>
